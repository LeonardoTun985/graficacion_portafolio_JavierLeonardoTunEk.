  fill(30, 50, 100);

  triangle(0, 430, 180, 280, 350, 430);
  triangle(200, 430, 400, 250, 600, 430);
  triangle(450, 430, 650, 290, 800, 430);

  fill(25, 40, 80);

  triangle(0, 470, 150, 350, 300, 470);
  triangle(250, 470, 500, 330, 700, 470);
  triangle(550, 470, 700, 360, 800, 470);

  // Casas
  fill(50, 60, 100);
  rect(330, 420, 70, 70);
  rect(410, 400, 80, 90);
  rect(500, 425, 70, 65);
  rect(580, 410, 75, 80);

  fill(35, 30, 70);

  triangle(320, 420, 365, 380, 410, 420);
  triangle(400, 400, 450, 355, 500, 400);
  triangle(490, 425, 535, 385, 580, 425);
  triangle(570, 410, 617, 370, 665, 410);

  fill(255, 200, 50);

  rect(350, 440, 15, 20);
  rect(435, 425, 18, 25);
  rect(520, 445, 15, 20);
  rect(605, 430, 18, 22);

  fill(60, 70, 110);
  rect(230, 410, 60, 80);

  triangle(220, 410, 260, 320, 300, 410);

  fill(255, 200, 50);
  ellipse(260, 390, 18, 25);

  // ÁRBOL

  fill(25, 25, 35);

  triangle(90, 570, 130, 270, 180, 570);


  fill(20, 35, 45);

  triangle(110, 450, 60, 360, 130, 420);
  triangle(140, 430, 190, 330, 155, 470);
  triangle(120, 370, 80, 290, 145, 350);
  triangle(145, 330, 180, 250, 165, 390);

  // SUELO
 
  fill(25, 55, 65);
  rect(0, 490, 800, 110);

  stroke(60, 110, 100);
  strokeWeight(6);

  line(20, 520, 120, 510);
  line(160, 550, 260, 530);
  line(300, 515, 390, 535);
  line(430, 550, 520, 520);
  line(570, 530, 700, 550);
  line(680, 510, 780, 530);

  // TEXTO
 
  fill(255);
  noStroke();

  textSize(22);
  
  text("Noche estrellada - van gogh", 280, 585);
  textSize(11)
  text("El diseño gráfico fundamenta la representación del arte abstracto al aplicar principios de composición que organizan el caos visual en un mensaje comprensible.", 0, 500);
}
    
