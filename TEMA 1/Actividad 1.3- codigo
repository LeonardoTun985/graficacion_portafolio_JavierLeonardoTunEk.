function setup() {
  createCanvas(800, 600);
}

function draw() {
  background(20, 40, 100);

  //Nubes 
  
  strokeWeight(12);

  noFill();
  strokeWeight(12);

  stroke(40, 90, 180);
  arc(180, 180, 250, 120,100,10);
  arc(300, 120, 300, 150, 0, 22);
  arc(470, 180, 280, 140, 100,10);
  arc(620, 130, 300, 160, 0, 35);

  stroke(60, 120, 210);
  arc(220, 240, 250, 130, 0, 35);
  arc(390, 250, 300, 150, 35,35);
  arc(570, 250, 280, 140, 0, 35);

  stroke(80, 150, 220);
  arc(350, 320, 350, 140, 10.10);
  arc(650, 320, 300, 130, 0, 3);


  // ESTRELLAS

  fill(255, 220, 50);
  noStroke();
  ellipse(120, 90, 35, 35);

  fill(255, 210, 40);
  noStroke();
  ellipse(300, 70, 30, 30);

  stroke(255, 230, 80);
  strokeWeight(4);
  line(300, 35, 300, 105);
  line(265, 70, 335, 70);

  fill(255, 220, 60);
