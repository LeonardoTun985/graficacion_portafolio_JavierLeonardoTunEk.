// Flor de cepasuchil?
function flor(x, y, tam, angulo) {
  push();
  translate(x, y);
  rotate(angulo);
  scale(tam);

  noStroke();

  for (let i = 0; i < 12; i++) {
    push();
    rotate(TWO_PI * i / 12);

    fill(255, 130 + (i % 3) * 25, 15);
    ellipse(0, -13, 10, 21);

    pop();
  }

  fill(120, 60, 15);
  circle(0, 0, 12);

  pop();
}

// flowers flying jiji
function dibujarFloresFlotantes() {
  for (let f of flores) {
    f.y -= f.velocidad * 0.35;

    if (f.y < 55) {
      f.y = ESCENA_H - 20;
      f.x = random(ESCENA_W);
    }

    f.giro += 0.015;

    flor(
      f.x + sin(frameCount * 0.02 + f.x) * 12,
      f.y,
      f.tam,
      f.giro
    );
  }
}

// Velas
function dibujarVeladora(v) {
  push();
  translate(v.x, v.y);
  scale(v.tam);

  if (v.encendida) {
    noStroke();

    for (let r = 65; r > 5; r -= 10) {
      fill(255, 130, 25, map(r, 65, 5, 4, 22));
      circle(0, -13, r);
    }
  }

  // Vaso
  noStroke();
  fill(235, 210, 175);
  rect(-15, 0, 30, 38, 4);

  fill(255, 238, 190);
  rect(-10, 5, 20, 28, 3);


  fill(255, 255, 45);
  rect(-19, 35, 38, 6, 2);

  if (v.encendida) {
    push();

    translate(0, -10);

    let pulso = 1 + sin(frameCount * 0.2 + v.x) * 0.13;
    scale(
      pulso,
      1 + sin(frameCount * 0.27 + v.x) * 0.2
    );

    noStroke();

    fill(255, 90, 10, 70);
    ellipse(0, -5, 42, 55);

    fill(255, 120, 15);
    ellipse(0, -5, 19, 32);

    fill(255, 225, 90);
    ellipse(0, -3, 9, 19);

    pop();
  } else {
    noFill();
    stroke(175, 175, 190, 100);
    strokeWeight(1.5);

    let humo = sin(frameCount * 0.04 + v.x) * 3;
    arc(humo, -9, 8, 13, PI, TWO_PI);
  }

  pop();
}

// MONITOR CON CÓDIGO
function dibujarMonitor(x, y) {
  push();
  translate(x, y);

  fill(12, 22, 32);
  stroke(70, 200, 180);
  strokeWeight(3);
  rect(-65, -45, 130, 80, 5);

  noStroke();
  fill(40, 75, 85);
  rect(-57, -37, 114, 64);

  textAlign(LEFT, TOP);
  textSize(8);

  let lineas = [
    "class Memoria {",
    "  void honrar() {",
    "    ofrenda();",
    "    recordar();",
    "  }",
    "}"
  ];

  for (let i = 0; i < lineas.length; i++) {
    fill(
      i % 2 === 0
        ? color(80, 255, 170)
        : color(255, 190, 100)
    );

    text(lineas[i], -50, -30 + i * 10);
  }

  fill(90, 100, 110);
  rect(-8, 35, 16, 14);
  rect(-28, 48, 56, 6);

  pop();
}

// Gabinete de Servidores 
function dibujarServidor(x, y) {
  push();
  translate(x, y);

  fill(35, 42, 53);
  stroke(120, 130, 150);
  strokeWeight(2);
  rect(-38, -45, 76, 105, 4);

  for (let i = 0; i < 4; i++) {
    let yy = -35 + i * 23;

    noStroke();
    fill(60, 75, 88);
    rect(-30, yy, 60, 17, 2);

    for (let j = 0; j < 4; j++) {
      fill(
        j % 2 === 0
          ? color(50, 255, 150)
          : color(70, 180, 255)
      );

      circle(-22 + j * 12, yy + 8, 4);
    }

    stroke(130, 150, 165);

    for (let j = 0; j < 4; j++) {
      line(12 + j * 4, yy + 4, 12 + j * 4, yy + 13);
    }
  }

  pop();
}

// Calaveras Con Hipil
function dibujarCalaveritaLocal(x, y, estilo) {
  push();
  translate(x, y);

  // Cabeza
  noStroke();
  fill(235, 220, 190);
  ellipse(0, 0, 39, 36);

  // Cabello
  fill(65, 35, 35);
  arc(0, -9, 41, 24, PI, TWO_PI);

  // Flores del cabello
  flor(-13, -15, 0.25, frameCount );
  flor(12, -15, 0.25, -frameCount );

  // Ojos
  noStroke();
  fill(55, 30, 40);
  ellipse(-9, -3, 10, 13);
  ellipse(9, -3, 10, 13);

  fill(255, 170, 80);
  circle(-9, -3, 3);
  circle(9, -3, 3);

  fill(70, 35, 40);
  triangle(-3, 5, 3, 5, 0, 10);

  stroke(70, 35, 40);
  strokeWeight(2);
  line(-9, 12, 9, 12);

  for (let i = -5; i <= 5; i += 5) {
    line(i, 10, i, 14);
  }

  // Hipil
  noStroke();
  fill(245, 235, 210);

  beginShape();
  vertex(-12, 18);
  vertex(-17, 25);
  vertex(-25, 54);
  vertex(25, 54);
  vertex(17, 25);
  vertex(12, 18);
  endShape(CLOSE);

  // Cuello
  fill(255, 248, 225);
  ellipse(0, 22, 23, 12);

  // Bordado del cuello
  noFill();
  strokeWeight(2);

  let coloresBordado = [
    color(220, 45, 85),
    color(255, 150, 35),
    color(45, 160, 115),
    color(140, 75, 190)
  ];

  for (let i = 0; i < 4; i++) {
    stroke(coloresBordado[(i + estilo) % coloresBordado.length]);
    arc(0, 22, 12 + i * 4, 7 + i * 2, 0, PI);
  }

  // Flores bordadas
  noStroke();

  for (let i = 0; i < 3; i++) {
    let fx = (i - 1) * 12;
    let fy = 34 + (i % 2) * 9;

    flor(fx, fy, 0.24, i * 0.5);
  }

  // Borde inferior
  stroke(210, 65, 100);
  strokeWeight(2);
  line(-23, 51, 23, 51);

  stroke(255, 165, 45);
  line(-20, 55, 20, 55);

  // Brazo que saluda
  push();
  translate(12, 24);
  rotate(sin(frameCount * 0.12 + x) * 0.7 - 0.8);

  stroke(235, 220, 190);
  strokeWeight(7);
  line(0, 0, 20, -3);

  noStroke();
  fill(235, 220, 190);
  circle(22, -3, 9);

  pop();


  stroke(235, 220, 190);
  strokeWeight(6);
  line(-12, 25, -20, 37);

 
  noStroke();
  fill(235, 220, 190);
  ellipse(-8, 57, 12, 6);
  ellipse(8, 57, 12, 6);

  pop();
}

function dibujarMicrochip(x, y) {
  push();
  translate(x, y);
  rotate(sin(frameCount * 0.025) * 0.04);

  stroke(70, 220, 190);
  strokeWeight(3);

  for (let i = -2; i <= 2; i++) {
    line(-25, i * 9, -38, i * 9);
    line(25, i * 9, 38, i * 9);
    line(i * 9, -25, i * 9, -38);
    line(i * 9, 25, i * 9, 38);
  }

  stroke(255, 190, 70);
  strokeWeight(3);
  fill(30, 45, 55);
  rect(-25, -25, 50, 50, 5);

  noStroke();
  fill(80, 255, 190);
  textAlign(CENTER, CENTER);
  textSize(11);
  text("ISC", 0, -4);

  textSize(7);
  text("0101", 0, 9);

  pop();
}

function dibujarLuzInteractiva(offsetX, offsetY, escala) {
  let mx = (mouseX - offsetX) / escala;
  let my = (mouseY - offsetY) / escala;

  noStroke();

  for (let r = 180; r > 0; r -= 12) {
    fill(255, 153, 0, map(r, 180, 0, 2, 12));
    ellipse(mx, my, r * 2);
  }
}


