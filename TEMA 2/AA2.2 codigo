let flores = [];
let calaveritaSaluda = false;
let luzActiva = true;

const ESCENA_W = 900;
const ESCENA_H = 650;

let velas = [
  { x: 185, y: 455, tam: 0.8, encendida: true },
  { x: 715, y: 455, tam: 0.8, encendida: true },
  { x: 450, y: 340, tam: 0.65, encendida: true }
];

function setup() {
  createCanvas(windowWidth, windowHeight);
  angleMode(RADIANS);
  textFont("monospace");

  for (let i = 0; i < 18; i++) {
    flores.push({
      x: random(ESCENA_W),
      y: random(80, 580),
      tam: random(0.5, 1),
      velocidad: random(0.4, 1.2),
      giro: random(TWO_PI)
    });
  }
}

function draw() {
  background(0, 0, 0);

  // ESCENARIO RESPONSIVO
  let escala = min(width / ESCENA_W, height / ESCENA_H);
  let offsetX = (width - ESCENA_W * escala) / 2;
  let offsetY = (height - ESCENA_H * escala) / 2;

  push();
  translate(offsetX, offsetY);
  scale(escala);

  dibujarEstrellas();
  dibujarPapelPicado();
  dibujarPared();
  dibujarAltar();
  dibujarFloresFlotantes();

  for (let v of velas) {
    dibujarVeladora(v);
  }

  dibujarMonitor(330, 275);
  dibujarServidor(565, 300);

  // CALAVERITA 1: ROTACIÓN LOCAL
  push();
  translate(245, 375 + sin(frameCount * 0.05) * 4);
  rotate(sin(frameCount * 0.035) * 0.08);
  dibujarCalaveritaLocal(0, 0, 0);
  pop();

  // CALAVERITA 2: MOVIMIENTO Y SALUDO
  push();
  translate(655, 375 + sin(frameCount * 0.05 + 1) * 4);
  rotate(
    calaveritaSaluda
      ? sin(frameCount * 0.12) * 0.12
      : sin(frameCount * 0.035 + 1) * 0.06
  );
  dibujarCalaveritaLocal(0, 0, 1);
  pop();

  dibujarMicrochip(450, 525);

  if (luzActiva) {
    dibujarLuzInteractiva(offsetX, offsetY, escala);
  }

  dibujarTexto();

  pop();
}

// INTERACTIVIDAD DEL MOUSE
function mousePressed() {
  let escala = min(width / ESCENA_W, height / ESCENA_H);
  let offsetX = (width - ESCENA_W * escala) / 2;
  let offsetY = (height - ESCENA_H * escala) / 2;

  let mx = (mouseX - offsetX) / escala;
  let my = (mouseY - offsetY) / escala;

  for (let v of velas) {
    let ancho = 42 * v.tam;
    let izquierda = v.x - ancho;
    let derecha = v.x + ancho;
    let arriba = v.y - 35 * v.tam;
    let abajo = v.y + 45 * v.tam;

    if (
      mx >= izquierda &&
      mx <= derecha &&
      my >= arriba &&
      my <= abajo
    ) {
      v.encendida = !v.encendida;
      return false;
    }
  }

  calaveritaSaluda = !calaveritaSaluda;
  luzActiva = !luzActiva;

  return false;
}

